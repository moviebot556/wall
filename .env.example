# Railway Environment Variables Configuration

# Telegram Notifications (Generate via @BotFather in Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Helius RPC API Key
HELIUS_API_KEY=dad6493c-fff4-4280-8a90-857fdf98c1b3

# Custom RPCs (Comma-separated list of additional Solana RPC URLs)
# Example: https://solana-mainnet.g.alchemy.com/v2/...,https://solana-mainnet.quiknode.pro/...
CUSTOM_RPCS=

# Concurrency & Performance Settings
# Keep CONCURRENCY low (2-4) on free/hobby tiers to prevent CPU throttling & RPC rate limits
CONCURRENCY=4
DELAY_MS=200
RPC_TIMEOUT_SEC=5

# Port (Railway automatically sets the PORT variable, defaults to 8080)
PORT=8080
